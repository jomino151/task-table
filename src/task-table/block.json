{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "task-table/task-table",
    "version": "1.2.0",
    "title": "Task Table",
    "category": "text",
    "icon": "table",
    "description": "A table of open tasks that visitors can sign up for.",
    "example": {},
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "attributes": {
        "rows": {
            "type": "array",
            "default": []
        },
        "categoryId": {
            "type": "number",
            "default": 0
        }
    },
    "textdomain": "task-table",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css",
    "render": "file:./render.php",
    "viewScript": "file:./view.js"
}