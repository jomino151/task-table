# Level 6 and up mostly report missing type declarations on the untyped legacy functions
# (147 at level 6); raise the level as signatures get types.
parameters:
	level: 5
	paths:
		- task-table.php
		- uninstall.php
		- src
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	ignoreErrors:
		# build/ is generated by `npm run build`; CI analyses the sources without building.
		-
			identifier: require.fileNotFound
			path: src/task-table/render.php
			reportUnmatched: false   # matched only when build/ is missing
